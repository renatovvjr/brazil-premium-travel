VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI
RESEND_API_KEY=SUA_CHAVE_RESEND_AQUI
RESEND_FROM_EMAIL="Curated Brazil <applications@curatedbraziltravel.com>"

# Workspace 2.0 remains disabled unless an isolated database and server secrets are configured.
VITE_WORKSPACE_V2_ENABLED=false
VITE_WORKSPACE_V2_INTAKE_ENABLED=false
VITE_WORKSPACE_V2_SUPABASE_URL=https://PROJETO-ISOLADO.supabase.co
VITE_WORKSPACE_V2_SUPABASE_ANON_KEY=CHAVE_ANON_DO_PROJETO_ISOLADO
SUPABASE_URL=https://SEU-PROJETO-STAGING.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SOMENTE_NO_SERVIDOR
INTAKE_HASH_SECRET=SEGREDO_ALEATORIO_DE_PELO_MENOS_32_BYTES
INTAKE_ALLOWED_ORIGINS=http://localhost:5173
INTAKE_REQUIRE_CAPTCHA=false
# TURNSTILE_SECRET_KEY=CONFIGURAR_APENAS_SE_APROVADO
OUTBOX_WORKER_SECRET=SEGREDO_ALEATORIO_SEPARADO
# Enable only after an authenticated scheduler can POST /api/process-email-outbox.
# Transactional delivery is independent from bulk marketing.
EMAIL_DELIVERY_ENABLED=false
MARKETING_DISPATCH_ENABLED=false
APPLICATION_TO_EMAIL=hello@curatedbraziltravel.com
# No live payment-provider secret or webhook is configured; payments remain manual records.
# Production-only approval gate. Never enable during local development.
WORKSPACE_V2_PRODUCTION_APPROVED=false
